# Copy this file to .env and fill it in. Never commit .env.

# Local MySQL:  mysql://showcheck:showcheck_pw@localhost:3306/show_check
# Hosted MySQL with SSL (e.g. Aiven): add ?sslaccept=accept_invalid_certs to the end
DATABASE_URL="mysql://showcheck:showcheck_pw@localhost:3306/show_check"

# Any long random string, e.g. the output of: openssl rand -hex 32
JWT_SECRET="change-me"

# Where the frontend is served from (comma-separated if more than one)
FRONTEND_ORIGIN="http://localhost:3001"
